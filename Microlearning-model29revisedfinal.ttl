@prefix : <http://microlearning-model.edu/microlearning-model/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ls: <http://linkedscience.org/teach/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix esco: <http://data.europa.eu/esco/model#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix km4c: <http://www.disit.org/km4city/schema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix aiiso: <http://purl.org/vocab/aiiso/schema#> .
@prefix ontog: <http://ontogamif.org/ontology/core#> .
@prefix aktors: <http://www.aktors.org/ontology/portal#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix courseware: <http://courseware.rkbexplorer.com/ontologies/courseware#> .
@base <http://microlearning-model.edu/microlearning-model/> .

<http://microlearning-model.edu/microlearning-model> rdf:type owl:Ontology ;
                                                      :contactInfo "nahhas.safia@gmail.com" ;
                                                      :language "en" ;
                                                      dc:created "October 2025" ;
                                                      dc:description "The microlearning ontology aims to provide a model that assists microlearning designers in building or refining learning materials based on the principles of microlearning, while also connecting these materials to real-world competencies, real-world practical domains, and other related resources." ;
                                                      rdfs:label "Microlearning model ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://microlearning-model.edu/microlearning-model/contactInfo
:contactInfo rdf:type owl:AnnotationProperty .


###  http://microlearning-model.edu/microlearning-model/language
:language rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/created
dc:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://microlearning-model.edu/microlearning-model/LearningResourceTypeEnum
:LearningResourceTypeEnum rdf:type rdfs:Datatype ;
                          rdfs:comment "A closed set of allowed string values for schema:learningResourceType to ensure consistency and prevent misspellings."@en ;
                          owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                                owl:oneOf [ rdf:type rdf:List ;
                                                            rdf:first "Audio" ;
                                                            rdf:rest [ rdf:type rdf:List ;
                                                                       rdf:first "Flash card" ;
                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                  rdf:first "Infographic" ;
                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                             rdf:first "InteractiveGraphic" ;
                                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                                        rdf:first "Mix" ;
                                                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                                                   rdf:first "Quiz" ;
                                                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                                                              rdf:first "Simulation" ;
                                                                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                                                                         rdf:first "Text document" ;
                                                                                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                    rdf:first "Video recording" ;
                                                                                                                                                    rdf:rest rdf:nil
                                                                                                                                                  ]
                                                                                                                                       ]
                                                                                                                            ]
                                                                                                                 ]
                                                                                                      ]
                                                                                           ]
                                                                                ]
                                                                     ]
                                                          ]
                                              ] .


###  http://microlearning-model.edu/microlearning-model/maxDuration15m
:maxDuration15m rdf:type rdfs:Datatype ;
                owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                      owl:onDatatype xsd:integer ;
                                      owl:withRestrictions ( [ xsd:maxInclusive 15
                                                             ]
                                                           )
                                    ] .


###  http://microlearning-model.edu/microlearning-model/maxWordCount500
:maxWordCount500 rdf:type rdfs:Datatype ;
                 owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                       owl:onDatatype xsd:integer ;
                                       owl:withRestrictions ( [ xsd:maxInclusive 500
                                                              ]
                                                            )
                                     ] .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://microlearning-model.edu/microlearning-model/aimsForDynamic
:aimsForDynamic rdf:type owl:ObjectProperty ;
                rdfs:domain :microlearning ;
                rdfs:range ontog:GameDynamic ;
                rdfs:comment "Links the microlearning unit to the specific psychological or behavioral outcome (dynamic) it is designed to elicit, such as Status, Community, or Achievement."@en ;
                rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                rdfs:label "aimsForDynamic"@en .


###  http://microlearning-model.edu/microlearning-model/hasAssessmentMethod
:hasAssessmentMethod rdf:type owl:ObjectProperty ;
                     rdfs:domain :microlearning ;
                     rdfs:range courseware:Assessment-Method ;
                     rdfs:comment "to state the assessment methods of microlearning"@en ;
                     rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                     rdfs:label "hasAssessmentMethod"@en .


###  http://microlearning-model.edu/microlearning-model/hasDifficultyLevel
:hasDifficultyLevel rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.imsglobal.org/xsd/imsmd_v1p2.xsd#educational.difficulty> ;
                    rdfs:domain :microlearning ;
                    rdfs:range :DifficultyLevel ;
                    rdfs:comment "To represent the formal difficulty level of the microlearning, linking it to a controlled instance (e.g., 'easy', 'medium') derived from the LOM standard's educational difficulty."@en ;
                    rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                    rdfs:label "hasDifficultyLevel"@en .


###  http://microlearning-model.edu/microlearning-model/hasGamificationElement
:hasGamificationElement rdf:type owl:ObjectProperty ;
                        rdfs:domain :microlearning ;
                        rdfs:range ontog:GameDesignElement ;
                        rdfs:comment "Links the microlearning unit to a specific gamification element (e.g., Badge, Point, Leaderboard) from the OntoGamif ontology."@en ;
                        rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                        rdfs:label "hasGamificationElement"@en .


###  http://microlearning-model.edu/microlearning-model/hasInteractionType
:hasInteractionType rdf:type owl:ObjectProperty ;
                    rdfs:domain :microlearning ;
                    rdfs:range courseware:Student-Interaction-Type ;
                    rdfs:comment "to clarify how the learner can engage in this microlearning."@en ;
                    rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                    rdfs:label "hasInteractionType"@en .


###  http://microlearning-model.edu/microlearning-model/hasLearningMode
:hasLearningMode rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf schema:courseMode ;
                 rdfs:domain :microlearning ;
                 rdfs:range :LearningModeEnum ;
                 rdfs:comment "the learning mode of this microlearning, restricted to Online, Blended, or FaceToFace."@en ;
                 rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                 rdfs:label "hasLearningMode"@en .


###  http://microlearning-model.edu/microlearning-model/hasLearningStyle
:hasLearningStyle rdf:type owl:ObjectProperty ;
                  rdfs:domain schema:EducationalAudience ;
                  rdfs:range :LearningStyle ;
                  rdfs:comment "A custom property linking the audience to their preferred learning style (e.g., Visual, Kinesthetic)."@en ;
                  rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                  rdfs:label "hasLearningStyle"@en .


###  http://microlearning-model.edu/microlearning-model/hasMaterial
:hasMaterial rdf:type owl:ObjectProperty ;
             rdfs:domain :microlearning ;
             rdfs:range ls:Material ;
             rdfs:comment "to link the microlearning with its related materials."@en ;
             rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
             rdfs:label "hasMaterial"@en .


###  http://microlearning-model.edu/microlearning-model/hasObjective
:hasObjective rdf:type owl:ObjectProperty ;
              rdfs:domain :microlearning ;
              rdfs:range :Objective ;
              rdfs:comment "state the objective of the microlearning"@en ;
              rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
              rdfs:label "hasObjective"@en .


###  http://microlearning-model.edu/microlearning-model/hasRelatedDomain
:hasRelatedDomain rdf:type owl:ObjectProperty ;
                  rdfs:domain :microlearning ;
                  rdfs:range :PracticalDomain ;
                  rdfs:comment "Relates a microlearning unit to the real-world practical domain addressed by its educational content."@en ;
                  rdfs:label "has related domain"@en .


###  http://microlearning-model.edu/microlearning-model/hasRelatedKM4CService
:hasRelatedKM4CService rdf:type owl:ObjectProperty ;
                       rdfs:domain :PracticalDomain ;
                       rdfs:range km4c:Service ;
                       rdfs:comment "Links a practical domain to a related service resource defined in the KM4City vocabulary."@en ;
                       rdfs:label "has related KM4City service"@en .


###  http://microlearning-model.edu/microlearning-model/hasRelatedOccupation
:hasRelatedOccupation rdf:type owl:ObjectProperty ;
                      rdfs:domain :microlearning ;
                      rdfs:range esco:Occupation ;
                      rdfs:comment "to connect between microlearning and its related occupation"@en ;
                      rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                      rdfs:label "hasRelatedOccupation"@en .


###  http://microlearning-model.edu/microlearning-model/hasSkill
:hasSkill rdf:type owl:ObjectProperty ;
          rdfs:domain :microlearning ;
          rdfs:range esco:Skill ;
          rdfs:comment "to link the microlearning to skills that the learner will gain after finishing it."@en ;
          rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
          rdfs:label "hasSkill"@en .


###  http://microlearning-model.edu/microlearning-model/hasSubject
:hasSubject rdf:type owl:ObjectProperty ;
            rdfs:domain :microlearning ;
            rdfs:range aiiso:Subject ;
            rdfs:comment "to provide the subject of the microlearning"@en ;
            rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
            rdfs:label "hasSubject"@en .


###  http://microlearning-model.edu/microlearning-model/isModuleOfSeries
:isModuleOfSeries rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf dcterms:isPartOf ,
                                     schema:isPartOf ;
                  rdfs:domain :microlearning ;
                  rdfs:range :MicrolearningSeries ;
                  rdfs:comment "To link a microlearning module to the overarching Microlearning Series or Library it belongs to."@en ;
                  rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                  rdfs:label "isModuleOfSeries"@en .


###  http://microlearning-model.edu/microlearning-model/isMotivatedByDynamic
:isMotivatedByDynamic rdf:type owl:ObjectProperty ;
                      rdfs:domain schema:EducationalAudience ;
                      rdfs:range ontog:GameDynamic ;
                      rdfs:comment "Links the Educational Audience to the specific Game Dynamics (e.g., Status, Achievement, Community) that serve as the primary motivational drive for this learner type."@en ;
                      rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                      rdfs:label "isMotivatedByDynamic"@en .


###  http://microlearning-model.edu/microlearning-model/isPartofGamificationSystem
:isPartofGamificationSystem rdf:type owl:ObjectProperty ;
                            rdfs:domain :microlearning ;
                            rdfs:range ontog:GamificationSystem ;
                            rdfs:comment "Links the microlearning module to the overarching gamification system it belongs to (the 'game')."@en ;
                            rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                            rdfs:label "isPartofGamificationSystem"@en .


###  http://microlearning-model.edu/microlearning-model/isProvidedBy
:isProvidedBy rdf:type owl:ObjectProperty ;
              owl:inverseOf :provides ;
              rdfs:domain :microlearning ;
              rdfs:range :Creator ;
              rdfs:comment "to state that this microlearning is provided by this creator"@en ;
              rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
              rdfs:label "isProvidedBy"@en .


###  http://microlearning-model.edu/microlearning-model/prefersGameElement
:prefersGameElement rdf:type owl:ObjectProperty ;
                    rdfs:domain schema:EducationalAudience ;
                    rdfs:range ontog:GameDesignElement ;
                    rdfs:comment "Links the Educational Audience to the specific Game Design Elements (e.g., Badges, Points) that are most preferred or effective for this type of learner profile."@en ;
                    rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                    rdfs:label "prefersGameElement"@en .


###  http://microlearning-model.edu/microlearning-model/prefersInteractionType
:prefersInteractionType rdf:type owl:ObjectProperty ;
                        rdfs:domain schema:EducationalAudience ;
                        rdfs:range courseware:Student-Interaction-Type ;
                        rdfs:comment "Defines the preferred method of engagement (e.g., \"Active interaction\" or \"Expose\")."@en ;
                        rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                        rdfs:label "prefersInteractionType"@en .


###  http://microlearning-model.edu/microlearning-model/provides
:provides rdf:type owl:ObjectProperty ;
          rdfs:domain :Creator ;
          rdfs:range :microlearning ;
          rdfs:comment "to state who provides the microlearning."@en ;
          rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
          rdfs:label "provides"@en .


###  http://microlearning-model.edu/microlearning-model/requiresLearningTools
:requiresLearningTools rdf:type owl:ObjectProperty ;
                       rdfs:domain :microlearning ;
                       rdfs:range aktors:Technology ;
                       rdfs:comment "to link between the microlearning and the required technologies to take it suh as mobiles, tablets and so on."@en ;
                       rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                       rdfs:label "requiresLearningTools"@en .


###  http://microlearning-model.edu/microlearning-model/respondsWellToMechanic
:respondsWellToMechanic rdf:type owl:ObjectProperty ;
                        rdfs:domain schema:EducationalAudience ;
                        rdfs:range ontog:GameMechanic ;
                        rdfs:comment "Links the Educational Audience to the specific Game Mechanics (e.g., Competition, Cooperation) that elicit the most positive engagement for this learner profile."@en ;
                        rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                        rdfs:label "respondsWellToMechanic"@en .


###  http://purl.org/dc/terms/isPartOf
dcterms:isPartOf rdf:type owl:ObjectProperty .


###  http://schema.org/audience
schema:audience rdf:type owl:ObjectProperty ;
                rdfs:domain :microlearning ;
                rdfs:range schema:Audience ,
                           schema:EducationalAudience ;
                rdfs:comment "An intended audience, i.e. a group for whom something was created."@en ;
                rdfs:isDefinedBy "http://schema.org/" ;
                rdfs:label "audience"@en .


###  http://schema.org/courseMode
schema:courseMode rdf:type owl:ObjectProperty ;
                  rdfs:domain :microlearning ;
                  rdfs:range :LearningModeEnum ;
                  rdfs:comment "The delivery method of the microlearning, restricted to Online, Blended, or FaceToFace."@en ;
                  rdfs:isDefinedBy "http://schema.org/" ;
                  rdfs:label "courseMode"@en .


###  http://schema.org/interest
schema:interest rdf:type owl:ObjectProperty ;
                rdfs:domain schema:EducationalAudience ;
                rdfs:range skos:Concept ;
                rdfs:comment "The topic or subject matter in which the target audience is interested."@en ;
                rdfs:isDefinedBy "http://schema.org/" ;
                rdfs:label "interest"@en .


###  http://schema.org/isPartOf
schema:isPartOf rdf:type owl:ObjectProperty .


###  http://schema.org/seeks
schema:seeks rdf:type owl:ObjectProperty ;
             rdfs:domain schema:EducationalAudience ;
             rdfs:range schema:Demand ;
             rdfs:comment "Links a party (the audience/learner) to a formal expression of what they are trying to obtain, acquire, or purchase."@en ;
             rdfs:isDefinedBy "http://schema.org/" ;
             rdfs:label "seeks"@en .


###  http://www.imsglobal.org/xsd/imsmd_v1p2.xsd#educational.difficulty
<http://www.imsglobal.org/xsd/imsmd_v1p2.xsd#educational.difficulty> rdf:type owl:ObjectProperty ;
                                                                     rdfs:isDefinedBy "http://www.imsglobal.org/" ;
                                                                     rdfs:label "difficulty"@en .


###  http://www.w3.org/2004/02/skos/core#related
skos:related rdf:type owl:ObjectProperty ;
             rdfs:domain :microlearning ;
             rdfs:range aiiso:Programme ;
             rdfs:comment "is used to assert an associative link between microlearning and a study program."@en ;
             rdfs:isDefinedBy "http://www.w3.org/2004/02/skos/" ;
             rdfs:label "skos:related"@en .


#################################################################
#    Data properties
#################################################################

###  http://ltsc.ieee.org/vcard/ns#typicalLearningTime
<http://ltsc.ieee.org/vcard/ns#typicalLearningTime> rdf:type owl:DatatypeProperty ;
                                                    rdfs:comment "Approximate or typical time it takes to work with this resource."@en ;
                                                    rdfs:isDefinedBy "http://ltsc.ieee.org/" ;
                                                    rdfs:label "typicalLearningTime"@en .


###  http://microlearning-model.edu/microlearning-model/durationInMinutes
:durationInMinutes rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf schema:duration ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain :microlearning ;
                   rdfs:range :maxDuration15m ;
                   rdfs:comment "to represent the lenght of microlearning (max 15 minutes)"@en ;
                   rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                   rdfs:label "durationInMinutes"@en .


###  http://microlearning-model.edu/microlearning-model/hasVisualElements
:hasVisualElements rdf:type owl:DatatypeProperty ;
                   rdfs:domain :microlearning ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "A boolean flag (True/False) indicating if the microlearning resource is primarily visual. This includes static graphics (e.g., Infographics), interactive visuals (e.g., Simulations), and time-based visual media (e.g., Video recordings). It is intended for simple filtering and should be used alongside 'schema:learningResourceType' for specific format detail."@en ;
                   rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                   rdfs:label "hasVisualElements"@en .


###  http://microlearning-model.edu/microlearning-model/multisensoryResource
:multisensoryResource rdf:type owl:DatatypeProperty ;
                      rdfs:domain :microlearning ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "to emphisis on the importance of having multisensory resource by contaning mix content of visual, audio, text and so on"@en ;
                      rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                      rdfs:label "multisensoryResource"@en .


###  http://microlearning-model.edu/microlearning-model/prefersResourceType
:prefersResourceType rdf:type owl:DatatypeProperty ;
                     rdfs:domain schema:EducationalAudience ;
                     rdfs:range :LearningResourceTypeEnum ;
                     rdfs:comment "States the Educational Audience's preferred content format (e.g., \"Video recording\" or \"Infographic\")."@en ;
                     rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                     rdfs:label "prefersResourceType"@en .


###  http://microlearning-model.edu/microlearning-model/textPrerequisites
:textPrerequisites rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf schema:coursePrerequisites ;
                   rdfs:domain :microlearning ;
                   rdfs:range xsd:string ;
                   rdfs:comment "to state any knowledge or skills needed before engaging in this microlearning."@en ;
                   rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                   rdfs:label "textPrerequisites"@en .


###  http://microlearning-model.edu/microlearning-model/hasPrerequisite
:hasPrerequisite rdf:type owl:ObjectProperty ;
                 rdfs:domain :microlearning ;
                 rdfs:range :microlearning ;
                 rdfs:comment "Relates a microlearning unit to another microlearning unit that must be completed beforehand."@en ;
                 rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                 rdfs:label "hasPrerequisite"@en .


###  http://microlearning-model.edu/microlearning-model/typicalLearningTime
:typicalLearningTime rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf <http://ltsc.ieee.org/vcard/ns#typicalLearningTime> ;
                     rdfs:domain :microlearning ;
                     rdfs:range xsd:duration ;
                     rdfs:comment "The estimated time a learner needs to spend to effectively study, absorb, and process the content of this microlearning unit, which often exceeds the resource's actual duration (e.g., 5-minute video + 55 minutes of study)."@en ;
                     rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                     rdfs:label "typicalLearningTime"@en .


###  http://microlearning-model.edu/microlearning-model/uriPrerequisites
:uriPrerequisites rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf schema:coursePrerequisites ;
                  rdfs:domain :microlearning ;
                  rdfs:range xsd:anyURI ;
                  rdfs:comment "to state any other prerequisites resources."@en ;
                  rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                  rdfs:label "uriPrerequisites"@en .


###  http://microlearning-model.edu/microlearning-model/wordCount
:wordCount rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf schema:wordCount ;
           rdfs:domain :microlearning ;
           rdfs:range :maxWordCount500 ;
           rdfs:comment "to represent number of words in this microlearning (max 500)"@en ;
           rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
           rdfs:label "wordCount"@en .


###  http://purl.org/dc/elements/1.1/language
dc:language rdf:type owl:DatatypeProperty ;
            rdfs:domain :microlearning ;
            rdfs:range xsd:language ;
            rdfs:comment "to represent the language of microlearning"@en ;
            rdfs:isDefinedBy "http://purl.org/dc/terms/" ;
            rdfs:label "language"@en .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( courseware:Assessment-Method
                                     courseware:Student-Interaction-Type
                                     esco:Occupation
                                     esco:Skill
                                     :Creator
                                     :MicrolearningSeries
                                     :Objective
                                     :microlearning
                                     aiiso:Programme
                                     aiiso:Subject
                                     aktors:Technology
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:comment "for giving the main title"@en ;
         rdfs:isDefinedBy "http://purl.org/dc/terms/" ;
         rdfs:label "title"@en .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Objective
                                                :microlearning
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    rdfs:comment "to give more details and descriptions"@en ;
                    rdfs:isDefinedBy "http://purl.org/dc/terms/" ;
                    rdfs:label "description"@en .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:DatatypeProperty ;
                rdfs:domain :microlearning ;
                rdfs:range rdfs:Resource ;
                rdfs:comment "A legal document or statement giving official permission to do something with the microlearning resource. Recommended practice is to use a URI."@en ;
                rdfs:isDefinedBy "http://purl.org/dc/terms/" ;
                rdfs:label "license"@en .


###  http://schema.org/coursePrerequisites
schema:coursePrerequisites rdf:type owl:DatatypeProperty ;
                           rdfs:comment "Requirements for taking the Course. May be completion of another Course or a textual description like 'permission of instructor'. Requirements may be a pre-requisite competency, referenced using AlignmentObject"@en ;
                           rdfs:isDefinedBy "http://schema.org/" ;
                           rdfs:label "coursePrerequisites"@en .


###  http://schema.org/duration
schema:duration rdf:type owl:DatatypeProperty ;
                rdfs:comment "duration of the content by shema"@en ;
                rdfs:isDefinedBy "http://schema.org/" ;
                rdfs:label "duration"@en .


###  http://schema.org/educationalLevel
schema:educationalLevel rdf:type owl:DatatypeProperty ;
                        rdfs:domain schema:EducationalAudience ;
                        rdfs:range xsd:string ;
                        rdfs:comment "The level of education or prerequisite knowledge required or targeted by the content (e.g., 'Grade 10', 'Intermediate', 'Post-Graduate')."@en ;
                        rdfs:isDefinedBy "http://schema.org/" ;
                        rdfs:label "educationalLevel"@en .


###  http://schema.org/educationalRole
schema:educationalRole rdf:type owl:DatatypeProperty ;
                       rdfs:domain schema:EducationalAudience ;
                       rdfs:range xsd:string ;
                       rdfs:comment "The role (e.g., student, teacher) the target audience plays in an educational context."@en ;
                       rdfs:isDefinedBy "http://schema.org/educationalRole" ;
                       rdfs:label "educationalRole"@en .


###  http://schema.org/learningResourceType
schema:learningResourceType rdf:type owl:DatatypeProperty ;
                            rdfs:domain :microlearning ;
                            rdfs:range :LearningResourceTypeEnum ;
                            rdfs:comment "the predominant type or kind characterizing the learning resource."@en ;
                            rdfs:isDefinedBy "http://schema.org/" ;
                            rdfs:label "learningResourceType"@en .


###  http://schema.org/position
schema:position rdf:type owl:DatatypeProperty ;
                rdfs:domain :microlearning ;
                rdfs:range xsd:integer ;
                rdfs:comment "hold the series number of the micolearining"@en ;
                rdfs:isDefinedBy "http://schema.org/" ;
                rdfs:label "position"@en .


###  http://schema.org/proficiencyLevel
schema:proficiencyLevel rdf:type owl:DatatypeProperty ;
                        rdfs:domain schema:EducationalAudience ;
                        rdfs:range xsd:string ;
                        rdfs:comment "The required or targeted competency level of the audience (e.g., 'B2', 'Expert', 'Novice')."@en ;
                        rdfs:isDefinedBy "http://schema.org/" ;
                        rdfs:label "proficiencyLevel"@en .


###  http://schema.org/wordCount
schema:wordCount rdf:type owl:DatatypeProperty ;
                 rdfs:comment "to represent the number of words by schema"@en ;
                 rdfs:isDefinedBy "http://schema.org/" ;
                 rdfs:label "wordCount"@en .


#################################################################
#    Classes
#################################################################

###  http://courseware.rkbexplorer.com/ontologies/courseware#Assessment-Method
courseware:Assessment-Method rdf:type owl:Class ;
                             rdfs:comment "A method by which a learner is assessed; instances of this class may include examination, coursework, etc."@en ;
                             rdfs:isDefinedBy "http://courseware.rkbexplorer.com/ontologies/courseware" ;
                             rdfs:label "Assessment-Method"@en .


###  http://courseware.rkbexplorer.com/ontologies/courseware#LearningObject
courseware:LearningObject rdf:type owl:Class ;
                          rdfs:comment "Any entity, digital or non-digital, that may be used for learning, education or training."@en ;
                          rdfs:isDefinedBy "http://courseware.rkbexplorer.com/ontologies/courseware" ;
                          rdfs:label "LearningObject"@en .


###  http://courseware.rkbexplorer.com/ontologies/courseware#Student-Interaction-Type
courseware:Student-Interaction-Type rdf:type owl:Class ;
                                    rdfs:comment "A type of interaction in which a learner engages whilst undertaking a micolearning."@en ;
                                    rdfs:isDefinedBy "http://courseware.rkbexplorer.com/ontologies/courseware" ;
                                    rdfs:label "Student-Interaction-Type"@en .


###  http://data.europa.eu/esco/model#LearningOutcome
esco:LearningOutcome rdf:type owl:Class ;
                     rdfs:isDefinedBy "Statements regarding what a learner knows, understands and is able to do on completion of a learning process, which are defined in terms of knowledge, skills and responsibility and autonomy" ,
                                      "http://data.europa.eu/esco" ;
                     rdfs:label "LearningOutcome"@en .


###  http://data.europa.eu/esco/model#Occupation
esco:Occupation rdf:type owl:Class ;
                rdfs:comment "The class of ESCO Occupation concepts..."@en ;
                rdfs:isDefinedBy "http://data.europa.eu/esco/" ;
                rdfs:label "Occupation"@en .


###  http://data.europa.eu/esco/model#Skill
esco:Skill rdf:type owl:Class ;
           rdfs:comment "The class of ESCO Skill concepts...."@en ;
           rdfs:isDefinedBy "http://data.europa.eu/esco/" ;
           rdfs:label "Skill"@en .


###  http://linkedscience.org/teach/ns#Material
ls:Material rdf:type owl:Class ;
            rdfs:comment "to add any other related material."@en ;
            rdfs:isDefinedBy "http://linkedscience.org/teach/" ;
            rdfs:label "Material"@en .


###  http://linkedscience.org/teach/ns#StudyProgram
ls:StudyProgram rdf:type owl:Class ;
                owl:equivalentClass aiiso:Programme ;
                rdfs:comment "A Programme is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a programme."@en ;
                rdfs:isDefinedBy "http://linkedscience.org/teach/" ;
                rdfs:label "StudyProgram"@en .


###  http://microlearning-model.edu/microlearning-model/Creator
:Creator rdf:type owl:Class ;
         rdfs:subClassOf foaf:Agent ;
         rdfs:comment "It represents who created the microlearning. It could be an educational institution, a company, a person, or others."@en ;
         rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
         rdfs:label "Creator"@en .


###  http://microlearning-model.edu/microlearning-model/DifficultyLevel
:DifficultyLevel rdf:type owl:Class ;
                 rdfs:comment "to represent the difficulty level of the micorlearning."@en ;
                 rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                 rdfs:label "DifficultyLevel"@en .


###  http://microlearning-model.edu/microlearning-model/FlashCardMicrolearning
:FlashCardMicrolearning rdf:type owl:Class ;
                        rdfs:subClassOf :microlearning ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty schema:learningResourceType ;
                                          owl:hasValue "Flash card"
                                        ] ;
                        rdfs:comment "A microlearning module specifically designed for rapid recall, repetition, and mastery using flash card mechanics."@en ;
                        rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                        rdfs:label "Flash Card Microlearning"@en .


###  http://microlearning-model.edu/microlearning-model/LearningModeEnum
:LearningModeEnum rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( schema:Blended
                                                    schema:FaceToFace
                                                    schema:Online
                                                  )
                                      ] ;
                  rdfs:comment "An enumeration class representing the allowed modes for microlearning delivery (Online, Blended, FaceToFace)."@en ;
                  rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                  rdfs:label "LearningModeEnum"@en .


###  http://microlearning-model.edu/microlearning-model/LearningStyle
:LearningStyle rdf:type owl:Class ;
               rdfs:comment "A classification of the preferred ways an audience acquires and processes information (e.g., VARK categories)."@en ;
               rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
               rdfs:label "LearningStyle"@en .


###  http://microlearning-model.edu/microlearning-model/MicrolearningSeries
:MicrolearningSeries rdf:type owl:Class ;
                     rdfs:subClassOf schema:CreativeWorkSeries ;
                     rdfs:comment "A cohesive collection of microlearning modules intended to be consumed sequentially or as a logical group, representing a 'Series' or 'Library'."@en ;
                     rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                     rdfs:label "MicrolearningSeries"@en .


###  http://microlearning-model.edu/microlearning-model/MobileDevice
:MobileDevice rdf:type owl:Class ;
              rdfs:subClassOf aktors:Technology ;
              rdfs:comment "A specialized class of Technology for portable handheld devices (e.g., smartphones, tablets). This class is used to explicitly mark microlearning instances as mobile-first, providing emphasis without creating a mandatory restriction on the parent :microlearning class."@en ;
              rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
              rdfs:label "MobileDevice"@en .


###  http://microlearning-model.edu/microlearning-model/MultisensoryResource
:MultisensoryResource rdf:type owl:Class ;
                      rdfs:subClassOf :microlearning ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :multisensoryResource ;
                                        owl:hasValue "true"^^xsd:boolean
                                      ] ;
                      rdfs:comment "A class representing microlearning modules that actively use multiple sensory inputs (e.g., visual and auditory) for enhanced learning, aligning with best practices."@en ;
                      rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                      rdfs:label "Multisensory Resource"@en .


###  http://microlearning-model.edu/microlearning-model/Objective
:Objective rdf:type owl:Class ;
           rdfs:subClassOf esco:LearningOutcome ;
           rdfs:comment "objective must be singular, specific, action-Oriented (use action verb), measurable, state what the learner will be able to do after the completion of this microlearning, task-Centricity (real-world task or competency),  can be achieved in short time limit."@en ;
           rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
           rdfs:label "Objective"@en .


###  http://microlearning-model.edu/microlearning-model/PracticalDomain
:PracticalDomain rdf:type owl:Class ;
                 rdfs:comment "A general class representing real-world practical domains relevant to microlearning content, including urban and non-urban domains such as healthcare, agriculture, education, industry, energy, and transportation."@en ;
                 rdfs:label "Practical Domain"@en .


###  http://microlearning-model.edu/microlearning-model/StandaloneMicrolearning
:StandaloneMicrolearning rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :microlearning
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :isModuleOfSeries ;
                                                                      owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :textPrerequisites ;
                                                                      owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :uriPrerequisites ;
                                                                      owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasPrerequisite ;
                                                                      owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty schema:position ;
                                                                      owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :microlearning ;
                         rdfs:comment "A self-contained microlearning unit that is not linked to a series, has no stated text or URI prerequisites, has no linked microlearning-unit prerequisites, and has no series position. Under the OWL Open-World Assumption, the absence of these property assertions alone does not establish membership in this class."@en ;
                         rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                         rdfs:label "StandaloneMicrolearning"@en .


###  http://microlearning-model.edu/microlearning-model/VideoMicrolearning
:VideoMicrolearning rdf:type owl:Class ;
                    rdfs:subClassOf :microlearning ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty schema:learningResourceType ;
                                      owl:hasValue "Video recording"
                                    ] ;
                    rdfs:comment "A microlearning module delivered as a short, focused video, often preferred for its ease of consumption and visual nature."@en ;
                    rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                    rdfs:label "Video Microlearning"@en .


###  http://microlearning-model.edu/microlearning-model/VisualMicrolearning
:VisualMicrolearning rdf:type owl:Class ;
                     rdfs:subClassOf :microlearning ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasVisualElements ;
                                       owl:hasValue "true"^^xsd:boolean
                                     ] ;
                     rdfs:comment "A microlearning module where the primary mode is highly visual content like infographics, charts, or diagrams, which is highly effective."@en ;
                     rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
                     rdfs:label "Visual Microlearning"@en .


###  http://microlearning-model.edu/microlearning-model/microlearning
:microlearning rdf:type owl:Class ;
               rdfs:subClassOf courseware:LearningObject ,
                               schema:CreativeWork ,
                               skos:Concept ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasObjective ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Objective
                               ] ;
               rdfs:comment "A short, focused learning unit or educational resource designed according to the microlearning approach. It delivers targeted, action-oriented content to achieve a specific learning objective within a limited period, typically a few seconds or minutes."@en ;
               rdfs:isDefinedBy "http://microlearning-model.edu/microlearning-model" ;
               rdfs:label "Microlearning"@en ,
               "Microlearning Unit"@en .


###  http://ontogamif.org/ontology/core#Achievement
ontog:Achievement rdf:type owl:Class ;
                  rdfs:subClassOf ontog:GameDynamic .


###  http://ontogamif.org/ontology/core#Badge
ontog:Badge rdf:type owl:Class ;
            rdfs:subClassOf ontog:GameDesignElement .


###  http://ontogamif.org/ontology/core#Challenge
ontog:Challenge rdf:type owl:Class ;
                rdfs:subClassOf ontog:GameDynamic ;
                rdfs:comment "A task or goal that requires effort and skill to overcome, often providing a sense of accomplishment."@en ;
                rdfs:isDefinedBy "http://ontogamif.org/" ;
                rdfs:label "Challenge"@en .


###  http://ontogamif.org/ontology/core#Community
ontog:Community rdf:type owl:Class ;
                rdfs:subClassOf ontog:GameDynamic ;
                rdfs:comment "The feeling of belonging, cooperation, and shared experience with other learners; driven by Cooperative mechanics."@en ;
                rdfs:isDefinedBy "http://ontogamif.org/" ;
                rdfs:label "Community"@en .


###  http://ontogamif.org/ontology/core#Competition
ontog:Competition rdf:type owl:Class ;
                  rdfs:subClassOf ontog:GameMechanic ;
                  rdfs:comment "A rule that pits individuals or groups against each other, often using Leaderboards or Points, to motivate performance."@en ;
                  rdfs:isDefinedBy "http://ontogamif.org/" ;
                  rdfs:label "Competition"@en .


###  http://ontogamif.org/ontology/core#Cooperation
ontog:Cooperation rdf:type owl:Class ;
                  rdfs:subClassOf ontog:GameMechanic ;
                  rdfs:comment "A rule that requires individuals or groups to work together toward a shared goal."@en ;
                  rdfs:isDefinedBy "http://ontogamif.org/" ;
                  rdfs:label "Cooperation"@en .


###  http://ontogamif.org/ontology/core#FeedbackLoop
ontog:FeedbackLoop rdf:type owl:Class ;
                   rdfs:subClassOf ontog:GameMechanic ;
                   rdfs:comment "The core process of providing users with information about their actions, triggering motivation to continue or change behavior."@en ;
                   rdfs:isDefinedBy "http://ontogamif.org/" ;
                   rdfs:label "FeedbackLoop"@en .


###  http://ontogamif.org/ontology/core#GameDesignElement
ontog:GameDesignElement rdf:type owl:Class ;
                        rdfs:comment "Represents the tangible, user-facing components of a gamified system. These are the \"things\" the learner sees and interacts with (the 'what')."@en ;
                        rdfs:isDefinedBy "http://ontogamif.org/" ;
                        rdfs:label "GameDesignElement"@en .


###  http://ontogamif.org/ontology/core#GameDynamic
ontog:GameDynamic rdf:type owl:Class ;
                  rdfs:comment "The top-level class representing the abstract motivational and psychological outcomes (dynamics) resulting from gamification mechanics and elements (The 'Why')."@en ;
                  rdfs:isDefinedBy "http://ontogamif.org/" ;
                  rdfs:label "GameDynamic"@en .


###  http://ontogamif.org/ontology/core#GameMechanic
ontog:GameMechanic rdf:type owl:Class ;
                   rdfs:comment "The top-level class representing the abstract rules or processes (mechanics) that drive engagement, such as Feedback Loops, Competition, or Cooperation (The 'How')."@en ;
                   rdfs:isDefinedBy "http://ontogamif.org/" ;
                   rdfs:label "GameMechanic"@en .


###  http://ontogamif.org/ontology/core#GamificationSystem
ontog:GamificationSystem rdf:type owl:Class ;
                         rdfs:comment "The conceptual entity that encompasses all gamification elements, mechanics, and users for a specific context."@en ;
                         rdfs:isDefinedBy "http://ontogamif.org/" ;
                         rdfs:label "GamificationSystem"@en .


###  http://ontogamif.org/ontology/core#Leaderboard
ontog:Leaderboard rdf:type owl:Class ;
                  rdfs:subClassOf ontog:GameDesignElement ;
                  rdfs:comment "A ranking system that compares players based on a metric, typically points, to encourage competition."@en ;
                  rdfs:isDefinedBy "http://ontogamif.org/" ;
                  rdfs:label "Leaderboard"@en .


###  http://ontogamif.org/ontology/core#Level
ontog:Level rdf:type owl:Class ;
            rdfs:subClassOf ontog:GameDesignElement ;
            rdfs:comment "A stage of progression that represents an increase in difficulty, status, or access to new content."@en ;
            rdfs:isDefinedBy "http://ontogamif.org/" ;
            rdfs:label "Level"@en .


###  http://ontogamif.org/ontology/core#Point
ontog:Point rdf:type owl:Class ;
            rdfs:subClassOf ontog:GameDesignElement ;
            rdfs:comment "A numerical value that a player can accumulate for completing actions or achieving goals."@en ;
            rdfs:isDefinedBy "http://ontogamif.org/" ;
            rdfs:label "Point"@en .


###  http://ontogamif.org/ontology/core#ProgressBar
ontog:ProgressBar rdf:type owl:Class ;
                  rdfs:subClassOf ontog:GameDesignElement ;
                  rdfs:comment "A visual indication of a user's completion status within a task, module, or goal."@en ;
                  rdfs:isDefinedBy "http://ontogamif.org" ;
                  rdfs:label "ProgressBar"@en .


###  http://ontogamif.org/ontology/core#Progression
ontog:Progression rdf:type owl:Class ;
                  rdfs:subClassOf ontog:GameDynamic ;
                  rdfs:comment "The feeling of forward movement, growth, and mastery over time; driven by Levels and Progress Bars."@en ;
                  rdfs:isDefinedBy "http://ontogamif.org/" ;
                  rdfs:label "Progression"@en .


###  http://ontogamif.org/ontology/core#Quest
ontog:Quest rdf:type owl:Class ;
            rdfs:subClassOf ontog:GameDesignElement ;
            rdfs:comment "A structured sequence of tasks, goals, or microlearning modules that a user follows to achieve a larger objective."@en ;
            rdfs:isDefinedBy "http://ontogamif.org/" ;
            rdfs:label "Quest"@en .


###  http://ontogamif.org/ontology/core#ResourceAcquisition
ontog:ResourceAcquisition rdf:type owl:Class ;
                          rdfs:subClassOf ontog:GameDynamic ;
                          rdfs:comment "The desire to gather, manage, and use virtual goods or assets to advance or customize."@en ;
                          rdfs:isDefinedBy "http://ontogamif.org/" ;
                          rdfs:label "ResourceAcquisition"@en .


###  http://ontogamif.org/ontology/core#Status
ontog:Status rdf:type owl:Class ;
             rdfs:subClassOf ontog:GameDynamic ;
             rdfs:comment "The desire for recognition, ranking, or social standing; often driven by Leaderboards and Points."@en ;
             rdfs:isDefinedBy "http://ontogamif.org/" ;
             rdfs:label "Status"@en .


###  http://ontogamif.org/ontology/core#SurpriseDiscovery
ontog:SurpriseDiscovery rdf:type owl:Class ;
                        rdfs:subClassOf ontog:GameDynamic ;
                        rdfs:comment "The enjoyment derived from unexpected rewards, hidden content, or emergent gameplay."@en ;
                        rdfs:isDefinedBy "http://ontogamif.org/" ;
                        rdfs:label "SurpriseDiscovery"@en .


###  http://ontogamif.org/ontology/core#UnlockableContent
ontog:UnlockableContent rdf:type owl:Class ;
                        rdfs:subClassOf ontog:GameDesignElement ;
                        rdfs:comment "Content, features, or materials that are hidden until a learner achieves a specific target or completes a prerequisite."@en ;
                        rdfs:isDefinedBy "http://ontogamif.org/" ;
                        rdfs:label "UnlockableContent"@en .


###  http://ontogamif.org/ontology/core#VirtualGood
ontog:VirtualGood rdf:type owl:Class ;
                  rdfs:subClassOf ontog:GameDesignElement ;
                  rdfs:comment "Digital items or assets (e.g., currency, decorations) that have value only within the system, used for customization or status."@en ;
                  rdfs:isDefinedBy "http://ontogamif.org/" ;
                  rdfs:label "VirtualGood"@en .


###  http://purl.org/locwd/schema#OCW
<http://purl.org/locwd/schema#OCW> rdf:type owl:Class ;
                                   rdfs:subClassOf ls:Material ;
                                   rdfs:comment "An OCW is a free and open digital publication of high quality educational materials, organized as courses. An OCW is available for use and adaptation under an open license, such as a Creative Commons license. Does not typically provide certification or access to faculty."@en ;
                                   rdfs:isDefinedBy "http://purl.org/locwd/" ;
                                   rdfs:label "OCW"@en .


###  http://purl.org/locwd/schema#OER
<http://purl.org/locwd/schema#OER> rdf:type owl:Class ;
                                   rdfs:subClassOf ls:Material ;
                                   rdfs:comment "OER are teaching, learning, and research resources that reside in the public domain or have been released under an intellectual property license that permits their free use or re-purposing by others. OER include full courses, course materials, modules, textbooks, streaming videos, tests, software, and any other tools, materials, or techniques used to support access to knowledge."@en ;
                                   rdfs:isDefinedBy "http://purl.org/locwd/" ;
                                   rdfs:label "OER"@en .


###  http://purl.org/vocab/aiiso/schema#Module
aiiso:Module rdf:type owl:Class ;
             rdfs:subClassOf ls:Material ;
             rdfs:comment "A Module is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a module."@en ;
             rdfs:isDefinedBy "http://purl.org/vocab/aiiso/" ;
             rdfs:label "Module"@en .


###  http://purl.org/vocab/aiiso/schema#Programme
aiiso:Programme rdf:type owl:Class ;
                rdfs:comment "A Programme is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a programme."@en ;
                rdfs:isDefinedBy "http://purl.org/vocab/aiiso/" ;
                rdfs:label "Programme"@en .


###  http://purl.org/vocab/aiiso/schema#Subject
aiiso:Subject rdf:type owl:Class ;
              rdfs:comment "A Subject is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a subject."@en ;
              rdfs:isDefinedBy "http://purl.org/vocab/aiiso/" ;
              rdfs:label "Subject"@en .


###  http://schema.org/Audience
schema:Audience rdf:type owl:Class ;
                rdfs:comment "An intended audience, i.e. a group for whom something was created."@en ;
                rdfs:isDefinedBy "http://schema.org/" ;
                rdfs:label "Audience"@en .


###  http://schema.org/CreativeWork
schema:CreativeWork rdf:type owl:Class ;
                    rdfs:comment "The most generic kind of creative content or creative work, including books, movies, photographs, software programs, etc."@en ;
                    rdfs:isDefinedBy "http://schema.org/" ;
                    rdfs:label "CreativeWork"@en .


###  http://schema.org/CreativeWorkSeries
schema:CreativeWorkSeries rdf:type owl:Class ;
                          rdfs:comment "A CreativeWorkSeries is a [[CreativeWork]] that is part of a series (e.g., a book series, a TV or radio series). The difference between a Series and a [[CreativeWork]] is the same as the difference between a set and an element."@en ;
                          rdfs:isDefinedBy "http://schema.org/" ;
                          rdfs:label "CreativeWorkSeries"@en .


###  http://schema.org/Demand
schema:Demand rdf:type owl:Class ;
              rdfs:comment "A demand entity represents a request for a certain commodity or service, or a need or interest in a certain offering."@en ;
              rdfs:isDefinedBy "http://schema.org/" ;
              rdfs:label "Demand"@en .


###  http://schema.org/EducationalAudience
schema:EducationalAudience rdf:type owl:Class ;
                           rdfs:subClassOf schema:Audience ;
                           rdfs:comment "An audience that is defined by an educational role"@en ;
                           rdfs:isDefinedBy "http://schema.org/" ;
                           rdfs:label "EducationalAudience"@en .


###  http://www.aktors.org/ontology/portal#Technology
aktors:Technology rdf:type owl:Class ;
                  rdfs:comment "Represents the technologies are needed to engage in this microlearning such as mobile, tablets and so on."@en ;
                  rdfs:isDefinedBy "http://www.aktors.org/" ;
                  rdfs:label "Technology"@en .


###  http://www.disit.org/km4city/schema#Accommodation
km4c:Accommodation rdf:type owl:Class ;
                   rdfs:subClassOf km4c:Service ;
                   rdfs:comment "A formal subclass of km4c:Service representing lodging, hotels, hostels, and residential services (Accommodation)."@en ;
                   rdfs:label "Accommodation"@en .


###  http://www.disit.org/km4city/schema#CulturalSite
km4c:CulturalSite rdf:type owl:Class ;
                  rdfs:subClassOf km4c:Service ;
                  rdfs:comment "A formal subclass of km4c:Service representing museums, theaters, historical sites, and cultural venues (Cultural Site)."@en ;
                  rdfs:label "Cultural Site"@en .


###  http://www.disit.org/km4city/schema#Education
km4c:Education rdf:type owl:Class ;
               rdfs:subClassOf km4c:Service ;
               rdfs:comment "A formal subclass of km4c:Service representing resources and services related to educational activities and facilities (Education)."@en ;
               rdfs:label "Education"@en .


###  http://www.disit.org/km4city/schema#HealthCare
km4c:HealthCare rdf:type owl:Class ;
                rdfs:subClassOf km4c:Service ;
                rdfs:comment "A formal subclass of km4c:Service representing hospitals, clinics, pharmacies, and medical centers (Health Care)."@en ;
                rdfs:label "Health Care"@en .


###  http://www.disit.org/km4city/schema#Public_administration
km4c:Public_administration rdf:type owl:Class ;
                           rdfs:subClassOf km4c:Service ;
                           rdfs:comment "A formal subclass of km4c:Service representing city halls, government offices, and administrative centers (Public Administration)."@en ;
                           rdfs:label "Public Administration"@en .


###  http://www.disit.org/km4city/schema#Restaurant
km4c:Restaurant rdf:type owl:Class ;
                rdfs:subClassOf km4c:Service ;
